{
  "name": "@netcatty/dsh-mcp",
  "version": "0.2.0",
  "description": "Lazy MCP manager for DeepSeek Harness: provisions the official MCP client, keeps tool schemas out of context until a session activates them, plus /mcp commands and a settings page",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netcatty/dsh-mcp.git"
  },
  "homepage": "https://github.com/netcatty/dsh-mcp#readme",
  "bugs": {
    "url": "https://github.com/netcatty/dsh-mcp/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "lazy-loading",
    "mcp-client",
    "mcp-manager"
  ]
}
